<Project>

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <Deterministic>true</Deterministic>

        <!-- Local development defaults; the PRF version resolver overrides these in CI. -->
        <Version Condition="'$(Version)' == ''">0.2.0-preview.1</Version>
        <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">0.2.0.0</AssemblyVersion>
        <FileVersion Condition="'$(FileVersion)' == ''">0.2.0.0</FileVersion>

        <Authors>PROGRAMARIS</Authors>
        <Company>PROGRAMARIS</Company>
        <Product>PROGRAMARIS Tenancy</Product>
        <Copyright>Copyright (c) 2026 PROGRAMARIS</Copyright>
        <RepositoryUrl>https://github.com/programaris/tenancy</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/programaris/tenancy</PackageProjectUrl>
        <PackageTags>programaris;tenancy;multi-tenant;dotnet;sdk</PackageTags>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>programaris-icon.png</PackageIcon>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup Condition="'$(MSBuildProjectName)' == 'Programaris.Tenancy.Abstractions'
               Or '$(MSBuildProjectName)' == 'Programaris.Tenancy'
               Or '$(MSBuildProjectName)' == 'Programaris.Tenancy.AspNetCore'
               Or '$(MSBuildProjectName)' == 'Programaris.Tenancy.Http'">

        <None Include="$(MSBuildThisFileDirectory)assets\programaris-icon.png" Pack="true" PackagePath="/" />

    </ItemGroup>

</Project>